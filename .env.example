# BriefKlick API credentials
# Obtain from https://www.briefklick.de/ (account settings)
BRIEFKLICK_API_KEY=your_api_key_here

# Optional: override default base URL (rarely needed)
# BRIEFKLICK_BASE_URL=https://api.briefklick.de/v2

# Optional: override HTTP timeouts in seconds (connect,read)
# BRIEFKLICK_TIMEOUT_CONNECT=10
# BRIEFKLICK_TIMEOUT_READ=60
